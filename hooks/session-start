#!/usr/bin/env bash
# SessionStart hook for etcd-druid plugin
# Injects medium orientation block into every Claude session.

set -euo pipefail

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

orientation=$(cat <<'ORIENTATION'
You are working on etcd-druid, a Kubernetes operator managing etcd clusters for Gardener.

## Three-Component System

etcd-druid (this repo)
  Kubernetes operator — owns the Etcd CRD, reconciles all cluster resources.
  Components implement the Operator interface: PreSync, Sync, TriggerDelete, GetExistingResourceNames.
  Controllers: etcd, compaction, etcdcopybackupstask, etcdopstask, secret.
  Logging: logr via log.FromContext(ctx).WithValues("etcd", req.NamespacedName).

etcd-backup-restore (sidecar)
  Manages snapshots, restore, and etcd initialization.
  HTTP API: /initialization/start, /initialization/status, /snapshot/full,
            /snapshot/delta, /snapshot/latest, /config, /healthz, /metrics
  Logging: logrus, field-based, level=info/error.

etcd-wrapper (sidecar)
  Calls backup-restore HTTP API to initialize etcd, then starts embedded etcd
  via go.etcd.io/etcd/server/v3/embed.
  Logging: zap, structured JSON.

## Working Directories
Fork (implementation):  your local fork of github.com/<your-github-user>/etcd-druid
Upstream (read-only):   github.com/gardener/etcd-druid (check git remotes if unsure)

NEVER commit to upstream.
NEVER push or create a PR without explicit human approval.

## Key Invariants
- New components must implement the Operator interface (all four methods: PreSync, Sync, TriggerDelete, GetExistingResourceNames)
- Error codes: typed string constants (druidapicommon.ErrorCode = "ERR_...") — never errors.New(); use druiderr.WrapError
- API changes in api/core/v1alpha1/ require CEL validation (+kubebuilder:validation:XValidation)
- After API changes: run `cd api && make generate` — two separate commits (API change, then generated output)
- Generated files (zz_generated.deepcopy.go, api/core/v1alpha1/crds/, charts/crds/, client/): NEVER edit manually
- etcd-druid tests: Go native testing.T + Gomega assertions — no Ginkgo in internal/component/ or internal/controller/etcd/
- etcd-wrapper tests: Go native testing.T + Gomega assertions
- etcd-backup-restore tests: Ginkgo v2 suite + Gomega assertions
- Pre-PR: make ci-checks && make test-unit && make test-integration
- Commits: imperative sentence case, issue number at end: "Fix X (#1350)", no trailing period
- Branch naming: ai/TASK-{issue-id}/claude/{short-description} in fork

## Available Skills
etcd-druid:feature-dev   Use when starting any feature, bug fix, or enhancement — design-to-PR with approval gates
etcd-druid:tdd           Use when writing or fixing tests across the three repos
etcd-druid:debug         Use when tests fail, reconciliation loops, backup failures, or unexpected behavior
etcd-druid:review        Use before submitting work — conventions and safety invariants checklist
etcd-druid:reference     Use for quick lookup: make targets, error patterns, operator interface, fake client, paths
ORIENTATION
)

escaped=$(escape_for_json "$orientation")

# Dynamic git context: branch + recent commits from cwd (best-effort, silent on failure)
git_context=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    commits=$(git log --oneline -3 2>/dev/null || true)
    if [ -n "$branch" ] || [ -n "$commits" ]; then
        raw_git="\\n## Current Git State\\nbranch: ${branch}\\nrecent commits:\\n${commits}"
        git_context=$(escape_for_json "$raw_git")
    fi
fi

session_context="<IMPORTANT>\\nYou are an expert etcd-druid developer assistant. Below is your orientation for this session:\\n\\n${escaped}${git_context}\\n</IMPORTANT>"

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
    printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
