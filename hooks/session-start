#!/usr/bin/env bash
# SessionStart hook for etcd-druid plugin
# Injects orientation block into every Claude session, with repo-aware context.

set -euo pipefail

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

orientation=$(cat <<'ORIENTATION'
You are working on the etcd-druid ecosystem — a set of components that manage etcd clusters for Gardener.

## Component System

etcd-druid (operator)  [v0.36.1 / v0.37.0-dev]
  Kubernetes operator — owns the Etcd CRD, reconciles all cluster resources.
  Components implement the Operator interface: PreSync, Sync, TriggerDelete, GetExistingResourceNames.
  10 components: clientservice, configmap, memberlease, peerservice, poddistruptionbudget,
    role, rolebinding, serviceaccount, snapshotlease, statefulset.
  Controllers: etcd, compaction, etcdcopybackupstask, etcdopstask, secret.
  3 CRDs: Etcd, EtcdCopyBackupsTask, EtcdOpsTask (druid.gardener.cloud/v1alpha1).
  EtcdOpsTask (v0.34+): one-shot operational tasks (OnDemandSnapshot, QuorumRecovery,
    Compaction, Defragmentation, BackupCopy); FIFO, one active task per cluster;
    also auto-triggered during hibernation (replicas=0) and UpgradeEtcdVersion flow;
    state machine: Pending→InProgress→Succeeded/Failed/Rejected.
  Feature gates (api/config/v1alpha1/features.go):
    UpgradeEtcdVersion — alpha, v0.36+ (coordinates etcd 3.5.27 upgrade across all repos).
    UseEtcdWrapper — GA, locked true (cannot be disabled).
  OperatorConfiguration: new config mechanism replacing CLI flags (v0.31+).
  druidctl CLI (druidctl/ — own go.mod): reconcile suspend/resume, resource protection, list/filter.
  Generated client library: client/ (clientset, informers, listers — separate go.mod).
  Build: make build (replaced make druid in v0.33). make ci-checks for pre-PR validation.
  CI: GitHub Actions (.github/workflows/base.yaml). golangci-lint v2.
  Logging: logr via log.FromContext(ctx).WithValues("etcd", req.NamespacedName).
  Go 1.24+ / etcd 3.5.27 / K8s v0.34.3.

etcd-backup-restore (sidecar)  [v0.42.0 / v0.43.0-dev]
  Manages snapshots, restore, and etcd initialization.
  HTTP API: /initialization/start, /initialization/status, /snapshot/full,
            /snapshot/delta, /snapshot/latest, /config, /healthz, /metrics.
            When --enable-profiling is true: /debug/pprof/* (10 endpoints).
  Subcommands: server, snapshot, restore, compact, initialize, copy.
  Key packages: snapshotter, restorer, compactor, defragmentor, initializer,
    member, leaderelection, health/heartbeat, snapstore, server.
  Snapshot providers: S3, ABS (Azure), GCS, Swift, OSS (Alibaba), ECS, OCS, Local.
  v0.40+: snapshot compression enabled by default (--compress-snapshots=true, gzip).
  v0.41+: --store-endpoint-override (replaces deprecated secret-based endpoint),
          dual-site backup sync (--secondary-* flags, Copier component).
  v0.42+: --enable-etcd-member-gc AND --k8s-member-gc-duration both REMOVED.
          --next-cluster-version-compatible flag added for etcd version upgrade.
  Immutable snapshots: S3 (Object Lock), ABS, GCS, OSS (WORM Lock).
  Build: make build, make verify (check + test-unit). Uses go mod vendor.
  CI: GitHub Actions (.github/workflows/build.yaml). golangci-lint v2.
  Logging: logrus, field-based, level=info/error.
  Go 1.25+ / etcd 3.5.27.

etcd-steward (planned sidecar — replaces etcd-backup-restore)
  Planned refactoring of etcd-backup-restore with cleaner architecture.
  Not yet in upstream — references here are forward-looking.
  Expected: Go native testing.T (no Ginkgo).

etcd-wrapper (sidecar)  [v0.7.0 / v0.8.0-dev]
  Calls backup-restore HTTP API to initialize etcd, then starts embedded etcd
  via go.etcd.io/etcd/server/v3/embed.
  Exposes /readyz (GET, port 9095) and /stop (POST) endpoints.
  CLI flags (stdlib flag, NOT cobra): --etcd-wrapper-port (9095),
    --etcd-client-port (2379), --backup-restore-host-port (:8080),
    --backup-restore-tls-enabled, --etcd-ready-timeout.
  Key packages: internal/app, internal/bootstrap, internal/brclient,
    internal/types, internal/util, internal/signal.
  Build: make build (CGO_ENABLED=0). Uses go mod vendor.
  CI: GitHub Actions (.github/workflows/build.yaml). golangci-lint v2.
  Logging: zap, structured JSON.
  Go 1.25+ / etcd 3.5.27.

## Etcd Version Upgrade Flow (UpgradeEtcdVersion — alpha, v0.36+)
Coordinated across all three repos:
1. etcd-druid enables feature gate, creates EtcdOpsTask (OnDemandSnapshot) before upgrade.
2. --next-cluster-version-compatible flag added to configmap for downgrade safety.
3. etcd-backup-restore passes flag to embedded etcd during compaction.
4. etcd-wrapper starts embedded etcd 3.5.27 with upgraded config.
If touching upgrade-related code, check all three repos for paired changes.

## Working Directories
Fork (implementation):  your local fork of github.com/<your-github-user>/etcd-druid
Upstream (read-only):   github.com/gardener/etcd-druid (check git remotes if unsure)

NEVER commit to upstream.
NEVER push or create a PR without explicit human approval.

## Key Invariants
- NEVER manually edit generated files (zz_generated.deepcopy.go, api/core/v1alpha1/crds/, charts/crds/, client/)
  A PreToolUse hook will BLOCK edits to these files automatically.
- After API changes: two commits — hand-written change first, then `cd api && make generate` output
- Pre-PR: make ci-checks && make test-unit && make test-integration
- Commits: imperative sentence case, issue number at end: "Fix X (#1350)", no trailing period
- Branch naming: ai/TASK-{issue-id}/claude/{short-description} in fork

## Development Guides (read before coding or reviewing)
Each repo has docs/development/ with authoritative conventions, patterns, and make targets.
When you find a pattern not documented there, add it as part of your work.

## Available Skills
etcd-druid:feature-dev   Use for any development work — picking up an issue, planning features or bug fixes, adding components or API fields, design-to-PR
etcd-druid:api-change    Use for API field additions or modifications — CEL validation, two-commit generate workflow, CRD tests
etcd-druid:tdd           Use when writing new tests or learning testing patterns — TDD cycle, framework selection, fake client, table-driven tests
etcd-druid:debug         Use when something is failing, broken, or behaving unexpectedly — build failures, test failures, reconciliation loops, backup failures
etcd-druid:review        Use when validating code before a PR — pre-merge checklist, self-review, pattern validation
etcd-druid:e2e           Use for manual e2e testing — KIND cluster setup, custom image builds, sidecar image overrides, pre-PR CI validation
etcd-druid:reference     Use for quick lookup: make targets, file paths, git workflow, branch naming
ORIENTATION
)

escaped=$(escape_for_json "$orientation")

# Detect which repo we are in and inject repo-specific context
repo_context=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    remote=$(git remote get-url origin 2>/dev/null || git remote get-url upstream 2>/dev/null || true)
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    commits=$(git log --oneline -3 2>/dev/null || true)

    # Identify repo from remote URL or directory name
    current_repo=""
    case "$remote" in
        *etcd-backup-restore*) current_repo="etcd-backup-restore" ;;
        *etcd-wrapper*)        current_repo="etcd-wrapper" ;;
        *etcd-druid*)          current_repo="etcd-druid" ;;
    esac
    # Fallback: check directory name
    if [ -z "$current_repo" ] && [ -n "$repo_root" ]; then
        dirname=$(basename "$repo_root")
        case "$dirname" in
            *etcd-backup-restore*) current_repo="etcd-backup-restore" ;;
            *etcd-wrapper*)        current_repo="etcd-wrapper" ;;
            *etcd-druid*)          current_repo="etcd-druid" ;;
            # Non-standard fork name: still inject default orientation without repo-specific docs
            *) current_repo="" ;;
        esac
    fi

    raw_repo=""
    if [ -n "$current_repo" ]; then
        raw_repo="\\n## Active Repo\\nYou are in: ${current_repo}\\nDevelopment guide: ${repo_root}/docs/development/"
        case "$current_repo" in
            etcd-druid)
                raw_repo="${raw_repo}\\nKey docs: testing.md, add-new-etcd-cluster-component.md, changing-api.md, raising-a-pr.md" ;;
            etcd-backup-restore)
                raw_repo="${raw_repo}\\nKey docs: tests.md, testing_and_dependencies.md, new_cp_support.md" ;;
            etcd-wrapper)
                raw_repo="${raw_repo}\\nKey docs: testing.md, contribution.md" ;;
        esac
    fi

    if [ -n "$branch" ] || [ -n "$commits" ]; then
        raw_repo="${raw_repo}\\n\\n## Current Git State\\nbranch: ${branch}\\nrecent commits:\\n${commits}"
    fi

    if [ -n "$raw_repo" ]; then
        repo_context=$(escape_for_json "$raw_repo")
    fi
fi

session_context="<IMPORTANT>\\nYou are an expert etcd-druid ecosystem developer assistant. Below is your orientation for this session:\\n\\n${escaped}${repo_context}\\n</IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0

